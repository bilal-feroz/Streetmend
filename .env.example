# StreetMend configuration (all optional). Copy to .env or export in your shell.

# Local language model for unrecognised assistant phrasing (Ollama).
STREETMEND_LLM=1                                 # 0 disables the model; the rule parser still works
STREETMEND_OLLAMA_URL=http://localhost:11434
STREETMEND_LLM_MODEL=qwen3:4b
STREETMEND_LLM_TIMEOUT=25                        # seconds

# Data directory (defaults to <repo>/data)
# STREETMEND_DATA=/path/to/data

# Allowed browser origins for the API
STREETMEND_CORS=http://localhost:5173,http://127.0.0.1:5173

# Web dev server -> API proxy target
# STREETMEND_API=http://127.0.0.1:8000
